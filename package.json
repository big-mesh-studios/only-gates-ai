{
  "name": "only-gates-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "bash ./build.sh",
    "build:lib": "pnpm --filter @only-gates-ai/core build",
    "dev": "npm run build:wasm && vite",
    "test": "cmake -S . -B build-tests -DBUILD_TESTING=ON && cmake --build build-tests --parallel && ctest --test-dir build-tests --output-on-failure",
    "test:lib": "pnpm --filter @only-gates-ai/core test",
    "format": "find . -type f \\( -name \"*.cpp\" -o -name \"*.h\" -o -name \"*.c\" -o -name \"*.hpp\" \\) | xargs clang-format -i"
  },
  "devDependencies": {
    "vite": "^8.3.6"
  }
}
