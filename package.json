{
  "name": "only-gates-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:lib": "pnpm --filter @only-gates-ai/core build",
    "build:compiler": "pnpm --filter @only-gates-ai/compiler build",
    "build:app": "pnpm --filter @only-gates-ai/app build",
    "build:learn": "pnpm --filter @only-gates-ai/learn build",
    "build:site": "pnpm build:app && pnpm build:learn && node scripts/assemble-learn.mjs",
    "dev": "npm run build:wasm && vite",
    "dev:app": "pnpm --filter @only-gates-ai/app dev",
    "dev:learn": "pnpm --filter @only-gates-ai/learn dev",
    "typecheck:learn": "pnpm --filter @only-gates-ai/learn typecheck",
    "test": "cmake -S . -B build-tests -DBUILD_TESTING=ON && cmake --build build-tests --parallel && ctest --test-dir build-tests --output-on-failure",
    "test:lib": "pnpm --filter @only-gates-ai/core test",
    "test:compiler": "pnpm --filter @only-gates-ai/compiler test",
    "test:luau": "python3 -m unittest scripts/test_luau_tasks.py scripts/test_luau_sft.py",
    "luau:tasks": "python3 scripts/luau_tasks.py --out data/luau-tasks --seed 1337",
    "luau:tokenizer": "python3 scripts/train_luau_tokenizer.py --out data/luau-tokenizer/tokenizer.json",
    "luau:notebook": "python3 scripts/build_luau_notebook.py",
    "luau:audit": "python3 scripts/audit_luau_prompts.py --tasks 'data/luau-tasks/*.jsonl'",
    "luau:check": "pnpm luau:audit && python3 scripts/check_luau_tasks.py --tasks data/luau-tasks/test-seen.jsonl --tasks data/luau-tasks/test-paraphrase.jsonl --tasks data/luau-tasks/test-question.jsonl --tasks data/luau-tasks/test-unseen.jsonl",
    "typecheck:app": "pnpm --filter @only-gates-ai/compiler build && pnpm --filter @only-gates-ai/app typecheck",
    "format": "find . -type f \\( -name \"*.cpp\" -o -name \"*.h\" -o -name \"*.c\" -o -name \"*.hpp\" \\) | xargs clang-format -i"
  },
  "devDependencies": {
    "vite": "^8.3.6"
  },
  "license": "MIT"
}
