{
  "name": "@only-gates-ai/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:core": "pnpm --filter @only-gates-ai/core build",
    "build:compiler": "pnpm --filter @only-gates-ai/compiler build",
    "dev": "pnpm run build:core && pnpm run build:compiler && vite",
    "build": "pnpm run build:core && pnpm run build:compiler && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@only-gates-ai/compiler": "workspace:*",
    "@only-gates-ai/core": "workspace:*",
    "@solidjs/web": "2.0.0-rc.21",
    "@tensorflow/tfjs": "4.22.0",
    "@tensorflow/tfjs-backend-webgpu": "4.22.0",
    "solid-js": "2.0.0-rc.21"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.56",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  },
  "license": "MIT"
}
